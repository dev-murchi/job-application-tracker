# ===================================================================
# Environment Configuration Template
# ===================================================================
# Usage: cp .env.example .env.<profile>
#        docker compose --profile <profile> --env-file .env.<profile> up
#
# Profiles: dev, prod-demo, backend-test, frontend-test
#
# Legend:
#   [D] = dev   
#   [T] = backend-test / frontend-test
#   [P] = prod-demo
#   [S] = Docker Swarm production (docker-stack.yml)
#
# See docs/GETTING_STARTED.md for detailed setup instructions.
# See docs/INFRASTRUCTURE.md for production deployment.
# ===================================================================

# ===== Application Configuration =====

# [D,T,P,S] Values: development, test, production
# Note: change to 'test' in .env.test, 'production' in .env.prod-demo
NODE_ENV=development

# [D,T] Host machine port mapped to the backend container
HOST_PORT=3000

# [D,T,P,S] Backend HTTP server port inside the container
SERVER_PORT=3000

# [D] Frontend dev server port (dev profile only)
FRONTEND_PORT=4200

# ===== MongoDB Configuration =====

# [D,P] Root credentials for MongoDB initialization (first run only)
MONGO_INITDB_ROOT_USERNAME=root_user
MONGO_INITDB_ROOT_PASSWORD=root_password

# [D,T,P] MongoDB connection string
# Dev:       mongodb://root_user:root_password@mongodb-dev:27017/jobs-tracker?authSource=admin
# Test:      mongodb://root_user:root_password@mongodb-test:27017/jobs-tracker?authSource=admin
# Prod-demo: mongodb://root_user:root_password@mongodb-prod:27017/jobs-tracker?authSource=admin
# Swarm:     Provided via Docker Secret (see MONGO_URL_SECRET_NAME)
MONGO_URL=mongodb://root_user:root_password@mongodb-dev:27017/jobs-tracker?authSource=admin

# [T] Optional override used by integration tests (preferred over MONGO_URL)
# Example: mongodb://root_user:root_password@mongodb-test:27017/jobs-tracker?authSource=admin
MONGO_TEST_URL=

# ===== JWT Configuration =====

# [D,T,P] JWT signing secret
# Swarm: Provided via Docker Secret (see JWT_SECRET_NAME)
# Generate a secure secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# [D,T,P,S] Token expiration (e.g., 1d, 7d, 30d, 12h)
JWT_LIFETIME=30d

# ===== CORS Configuration =====

# [D,T,P,S] Allowed origin(s) for cross-origin requests
# Use '*' or a comma-separated list of HTTP/HTTPS origins
# Example: https://app.example.com,https://admin.example.com
# Dev:       http://localhost:4200
# Prod-demo: https://localhost
# Swarm:     https://yourdomain.com
CORS_ORIGIN=http://localhost:4200

# [D,T,P,S] Number of reverse proxy hops to trust (Express trust proxy)
# Typical values: 1 (single proxy), 2 (host nginx -> frontend nginx -> backend)
TRUST_PROXY_HOPS=2

# ===== Rate Limiting =====

# [D,T,P,S] Window duration in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# [D,T,P,S] Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ===== Logging =====

# [D,T,P,S] Levels: error, warn, info, http, debug
LOG_LEVEL=info

# ===== Request Size Limit =====

# [D,T,P,S] Maximum request body size (e.g., 100kb, 1mb, 10mb)
REQUEST_SIZE_LIMIT=100kb

# ===== NGINX Configuration =====

# [P,S] NGINX HTTP port
NGINX_HTTP_PORT=80

# [P,S] NGINX HTTPS port
NGINX_HTTPS_PORT=443

# ===== Docker Swarm Configuration (production only) =====
# These reference pre-created Docker Swarm secrets and configs.
# See docs/INFRASTRUCTURE.md for creation instructions.
# Increment the version suffix (v1 → v2) when rotating.

# [S] Secret names (must match `docker secret create <name>`)
JWT_SECRET_NAME=jwt_secret_v1
MONGO_URL_SECRET_NAME=mongodb_url_v1
FRONTEND_SSL_CRT_SECRET_NAME=frontend_crt_v1
FRONTEND_SSL_PRIVKEY_SECRET_NAME=frontend_privkey_v1
SSL_CA_CRT_SECRET_NAME=ssl_ca_crt_v1

# [S] Config names (must match `docker config create <name>`)
FRONTEND_NGINX_DEF_CONFIG_NAME=nginx_conf_v1
FRONTEND_NGINX_APP_CONFIG_NAME=nginx_frontend_conf_v1

# [S] Container images (set by CI/CD pipeline or manual deploy)
# Format: <registry>/<repo>:<tag>@sha256:<digest>
# Example: ghcr.io/org/backend:1.0.0@sha256:abc123...
BACKEND_IMAGE=backend_image
FRONTEND_IMAGE=frontend_image

# ===== CI/CD Configuration (GitHub Secrets — not set in .env files) =====
# Configured in GitHub → Settings → Environments. Never stored in .env files.
# See docs/INFRASTRUCTURE.md for full setup instructions.
#
# --- GitHub Environment: production ---
# Used by: swarm-deploy.yml (deploy job)
#
# STACK_NAME                      — Docker Swarm stack name
# CR_PAT                          — GitHub Container Registry PAT
# CR_USERNAME                     — GHCR username
# DEPLOY_DIR                      — Remote deploy directory (e.g. /opt/deploy)
# VPS_SSH_HOST                    — VPS IP address or hostname
# VPS_SSH_USER                    — SSH username (ghactions)
# VPS_SSH_KEY                     — SSH private key (ed25519)
# VPS_SSH_PORT                    — SSH port
# SERVER_PORT                     — Backend HTTP port inside the container
# JWT_LIFETIME                    — Token expiry
# CORS_ORIGIN                     — Allowed origin
# RATE_LIMIT_WINDOW_MS            — Rate limit window in ms
# RATE_LIMIT_MAX_REQUESTS         — Max requests per window
# LOG_LEVEL                       — Log verbosity
# REQUEST_SIZE_LIMIT              — Max request body size
# JWT_SECRET_NAME                 — Docker secret name for JWT key
# MONGO_URL_SECRET_NAME           — Docker secret name for MongoDB URL
# FRONTEND_SSL_CRT_SECRET_NAME    — Docker secret name for SSL certificate
# FRONTEND_SSL_PRIVKEY_SECRET_NAME — Docker secret name for SSL private key
# SSL_CA_CRT_SECRET_NAME          — Docker secret name for CA certificate
# NGINX_HTTPS_PORT                — NGINX HTTPS port
# FRONTEND_NGINX_DEF_CONFIG_NAME  — Docker config name for NGINX default config
# FRONTEND_NGINX_APP_CONFIG_NAME  — Docker config name for NGINX app config