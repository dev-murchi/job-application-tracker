{
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "config/config.service.js",
    "crypto/**/*.js",
    "http-server/server.js",
    "http-server/request-handler/express/rest/controllers/**/*.js",
    "!http-server/request-handler/express/rest/controllers/index.js",
    "http-server/request-handler/express/rest/middlewares/auth.js",
    "http-server/request-handler/express/rest/middlewares/error-handler.js",
    "http-server/request-handler/express/rest/middlewares/not-found.js",
    "http-server/request-handler/express/rest/helpers/attach-cookie.js",
    "ioc/container.js",
    "security/**/*.js",
    "services/**/*.js",
    "!services/index.js",
    "!logger/winston/logger.js",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/coverage/**"
  ],
  "coverageDirectory": "coverage/unit",
  "coverageReporters": ["text", "lcov", "html"],
  "coverageThreshold": {
    "global": {
      "branches": 90,
      "functions": 90,
      "lines": 90,
      "statements": 90
    }
  },
  "testMatch": ["<rootDir>/tests/unit/**/*.test.js"],
  "clearMocks": true,
  "rootDir": "../",
  "modulePaths": ["<rootDir>"],
  "setupFilesAfterEnv": ["<rootDir>/tests/jest-unit-setup.js"],
  "testTimeout": 30000,
  "maxWorkers": "50%"
}
