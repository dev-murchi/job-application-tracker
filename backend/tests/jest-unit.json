{
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "server.js",
    "http/api/controllers/**/*.js",
    "!http/api/controllers/index.js",
    "ioc/container.js",
    "services/**/*.js",
    "!services/index.js",
    "http/api/middleware/**/*.js",
    "!http/api/middleware/rate-limiter.js",
    "!http/api/middleware/validator.js",
    "!http/api/middleware/index.js",
    "utils/**/*.js",
    "!logger/logger.js",
    "!config/config-validation.js",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/coverage/**"
  ],
  "coverageDirectory": "coverage/unit",
  "coverageReporters": ["text", "lcov", "html"],
  "coverageThreshold": {
    "global": {
      "branches": 90,
      "functions": 90,
      "lines": 90,
      "statements": 90
    }
  },
  "testMatch": ["<rootDir>/tests/unit/**/*.test.js"],
  "clearMocks": true,
  "rootDir": "../",
  "modulePaths": ["<rootDir>"],
  "setupFilesAfterEnv": ["<rootDir>/tests/jest-unit-setup.js"],
  "testTimeout": 30000,
  "maxWorkers": "50%"
}
