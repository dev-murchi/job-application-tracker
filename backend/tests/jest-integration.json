{
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "application/services/**/*.js",
    "adapters/infrastructure/config/config.service.js",
    "adapters/infrastructure/crypto/**/*.js",
    "adapters/infrastructure/security/**/*.js",
    "adapters/presentations/http-server/request-handler/express/rest/routers/**/*.js",
    "adapters/presentations/http-server/request-handler/express/rest/controllers/**/*.js",
    "adapters/presentations/http-server/request-handler/express/rest/middlewares/**/*.js",
    "!application/services/index.js",
    "!adapters/infrastructure/logger/winston/logger.js",
    "!adapters/presentations/http-server/request-handler/express/rest/controllers/index.js",
    "!adapters/presentations/http-server/request-handler/express/rest/middlewares/index.js",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/coverage/**"
  ],
  "coverageDirectory": "coverage/integration",
  "coverageReporters": ["text", "lcov", "html"],
  "coverageThreshold": {
    "global": {
      "branches": 83,
      "functions": 89,
      "lines": 90,
      "statements": 90
    }
  },
  "testMatch": ["<rootDir>/tests/integration/**/*.integration.test.js"],
  "clearMocks": true,
  "rootDir": "../",
  "modulePaths": ["<rootDir>"],
  "setupFilesAfterEnv": ["<rootDir>/tests/jest-integration-setup.js"],
  "testTimeout": 30000,
  "maxWorkers": "50%"
}
