{
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "config/config.service.js",
    "crypto/**/*.js",
    "http-server/request-handler/express/rest/controllers/**/*.js",
    "!http-server/request-handler/express/rest/controllers/index.js",
    "services/**/*.js",
    "security/**/*.js",
    "!services/index.js",
    "!services/config.service.js",
    "http-server/request-handler/express/rest/middlewares/**/*.js",
    "!http-server/request-handler/express/rest/middlewares/rate-limiter.js",
    "!http-server/request-handler/express/rest/middlewares/index.js",
    "http-server/request-handler/express/rest/routers/**/*.js",
    "!http-server/request-handler/express/rest/routers/index.js",
    "utils/**/*.js",
    "!logger/logger.js",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/coverage/**"
  ],
  "coverageDirectory": "coverage/integration",
  "coverageReporters": ["text", "lcov", "html"],
  "coverageThreshold": {
    "global": {
      "branches": 83,
      "functions": 89,
      "lines": 90,
      "statements": 90
    }
  },
  "testMatch": ["<rootDir>/tests/integration/**/*.integration.test.js"],
  "clearMocks": true,
  "rootDir": "../",
  "modulePaths": ["<rootDir>"],
  "setupFilesAfterEnv": ["<rootDir>/tests/jest-integration-setup.js"],
  "testTimeout": 30000,
  "maxWorkers": "50%"
}
